# Next.js
NEXT_PUBLIC_SITE_URL=https://smallplates.co

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WhatsApp Business (country code + number, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=your-whatsapp-number

# Feature flag: enable free-tier signup flow (no Stripe required)
NEXT_PUBLIC_FREE_TIER_ENABLED=false

# Feature flags: show the Cookbook Club and Framed Tiles sections on the
# landing page. Next.js inlines NEXT_PUBLIC_* variables at build time, so
# toggling these requires a new deployment, not just a server restart.
NEXT_PUBLIC_SHOW_CLUB=false
NEXT_PUBLIC_SHOW_TILES=false

# Optional Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
